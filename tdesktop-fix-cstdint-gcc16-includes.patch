 tgcalls/DirectConnectionChannel.h | 1 +
 tgcalls/Instance.h                | 1 +
 tgcalls/third-party/json11.cpp    | 1 +
 tgcalls/v2/SignalingConnection.h  | 1 +
 4 files changed, 4 insertions(+)

diff --git a/tgcalls/DirectConnectionChannel.h b/tgcalls/DirectConnectionChannel.h
index 50a41fcb..9c4742bf 100644
--- a/tgcalls/DirectConnectionChannel.h
+++ b/tgcalls/DirectConnectionChannel.h
@@ -1,6 +1,7 @@
 #ifndef TGCALLS_DIRECT_CONNECTION_CHANNEL_H
 #define TGCALLS_DIRECT_CONNECTION_CHANNEL_H
 
+#include <cstdint>
 #include <functional>
 #include <memory>
 #include <vector>
diff --git a/tgcalls/Instance.h b/tgcalls/Instance.h
index 5968b244..1ade11d0 100644
--- a/tgcalls/Instance.h
+++ b/tgcalls/Instance.h
@@ -1,6 +1,7 @@
 #ifndef TGCALLS_INSTANCE_H
 #define TGCALLS_INSTANCE_H
 
+#include <cstdint>
 #include <functional>
 #include <vector>
 #include <string>
diff --git a/tgcalls/third-party/json11.cpp b/tgcalls/third-party/json11.cpp
index 88024e92..45dbbcbe 100644
--- a/tgcalls/third-party/json11.cpp
+++ b/tgcalls/third-party/json11.cpp
@@ -22,6 +22,7 @@
 #include "json11.hpp"
 #include <cassert>
 #include <cmath>
+#include <cstdint>
 #include <cstdlib>
 #include <cstdio>
 #include <limits>
diff --git a/tgcalls/v2/SignalingConnection.h b/tgcalls/v2/SignalingConnection.h
index 3e95cb89..faf56e37 100644
--- a/tgcalls/v2/SignalingConnection.h
+++ b/tgcalls/v2/SignalingConnection.h
@@ -1,6 +1,7 @@
 #ifndef TGCALLS_SIGNALING_CONNECTION_H_
 #define TGCALLS_SIGNALING_CONNECTION_H_
 
+#include <cstdint>
 #include <memory>
 #include <vector>
 
